# ---------------------------------------------------------------------------
# DecisionOS — environment template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# OpenAI API key. Required for real AI analysis. Without it the app runs in
# DEMO MODE using the built-in example model (same schema as AI output).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional — defaults are shown
# Model used for model extraction (must support JSON mode / structured outputs)
OPENAI_MODEL=gpt-4o-mini
# Port the local analysis API listens on (Vite dev proxy points here)
PORT=8787
